#Although this file is processed as a shell script, DO NOT put shell code here!
#It is also read as a name=value pairs file by browsersettings.js
#Do not edit this file while MiningBots is running
#UI_MODE is one of "debug", "minimalist", or "fullscreen"
UI_MODE=debug
#Set this to false if using a server service (e.g. Apache)
START_WEB_SERVER=false
#If START_WEB_SERVER is true, Path of web server relative to root of application
REL_WEB_SERVER_PATH=webserver/abyssws
#Frontend URL to open in browser
FRONTEND_URL=http://localhost:8000
#TEST_MODE is a boolean value (true or false). If true, starts mb-server
TEST_MODE=false
#If TEST_MODE is true, TEST_MB_SERVER_PATH is a UNIX path to the mb-server
TEST_MB_SERVER_PATH=~/Documents/GitHub/miningbots/build/mb-server
